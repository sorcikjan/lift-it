# Lift It: proměnné prostředí. Zkopíruj do .env.local (lokálně) nebo do Vercelu (Settings → Environment Variables).
# Bez Supabase klíčů běží appka lokálně proti PGlite (Postgres ve WASM) s vývojovým uživatelem.

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Volitelné: starší projekty s HS256 JWT secretem. Nové projekty ověřují přes JWKS a tohle nepotřebují.
SUPABASE_JWT_SECRET=
# Postgres pro API routy (Settings → Database → Connection string → Transaction pooler, port 6543)
DATABASE_URL=

# --- Adresa appky (pro OAuth přesměrování a sdílené odkazy) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Šifrování tokenů integrací (Google refresh token, Strava) ---
# Vygeneruj: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth (stejný klient jako v Supabase → Authentication → Providers → Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Strava API (https://www.strava.com/settings/api) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Web push upozornění (vygeneruj: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tvuj@email.cz

# --- Jen vývoj a testy ---
# LIFTIT_DB=memory          # PGlite v paměti (výchozí je soubor .data/pglite)
# LIFTIT_DEV_AUTH=1         # vývojový uživatel i v produkčním buildu (jen e2e, nikdy na Vercelu)
# INTEGRATIONS_MOCK=1       # Google Sheets a Strava jako mocky
